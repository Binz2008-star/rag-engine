# --- API gateway ---
API_APP_NAME=RAG Assistant API
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (Next.js dev defaults shown).
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-request limits.
API_MAX_QUESTION_LENGTH=4000

# Directory containing the FAISS indexes built by
# `python scripts/build_indexes.py`. Defaults to `<repo>/models`.
# API_INDEX_DIR=models

# Ollama health check configuration (required at startup).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUIRED_MODELS=nomic-embed-text,robin-assistant-opt

# Chat model label for health endpoint (actual model used by LLMClient
# is read from project root .env via app.config to maintain parity).
CHAT_MODEL=robin-assistant-opt
