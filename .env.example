# Robin AI Pipeline Environment Configuration
# Copy this file to .env and fill in the actual values

# Environment Mode
ENV=production  # Set to "development" to disable API key auth

# Database (Neon PostgreSQL) - REQUIRED
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Email Configuration (Gmail SMTP)
GMAIL_USER=robenedwan@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx  # Generate at https://myaccount.google.com/apppasswords

# Notification
NOTIFY_EMAIL=robenedwan@gmail.com

# Company Info
COMPANY_NAME=ECO Technology Environmental Protection Services LLC
COMPANY_PHONE=+971 52 223 3989
WEBSITE=https://binz2008-star.github.io/eco-environmental-uae

# RAG Service Configuration
RAG_ENABLED=true
RAG_SERVICE_URL=http://localhost:8001

# API Authentication (required for production, optional for development)
API_KEY=your-secret-api-key-here
